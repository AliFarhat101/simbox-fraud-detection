# Copy this file to .env and fill in the values required by your local environment.
# Never commit the actual .env file.

# =========================
# Project
# =========================
PROJECT_ROOT=.

# =========================
# Data paths
# =========================
DATA_DIR=./data
RAW_CDR_PATH=./data/raw_cdr
PROFILES_PATH=./data/profiles
RESULTS_PATH=./data/results
DATABASE_PATH=./database/simbox.duckdb

# =========================
# MLflow
# =========================
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=simbox_fraud_detection

# =========================
# DVC / remote storage
# =========================
# Configure these only if using a remote DVC storage backend.
# DVC_REMOTE=
# DVC_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =========================
# Optional application settings
# =========================
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost